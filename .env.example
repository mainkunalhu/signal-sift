GROQ_API_KEY=
GROQ_PLANNER_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=qwen/qwen3-32b
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/signalsift
SEARXNG_URL=https://searx.be
TAVILY_API_KEY=
MAX_CONCURRENT_RESEARCHERS=4
# --- Phoenix tracing (Arize Cloud, no Docker needed) ---
# Sign up: https://app.phoenix.arize.com → Settings → API Keys
# Space-scoped keys need the space suffix: https://app.phoenix.arize.com/s/<SPACE_ID>/v1/traces
# (find SPACE_ID in Settings → Hostname, or ask setup to derive it from your key)
PHOENIX_ENDPOINT=https://app.phoenix.arize.com/s/<SPACE_ID>/v1/traces
PHOENIX_API_KEY=
API_PORT=8000
# --- Gateway + web (Phase 5) ---
# Gateway listens on PORT and proxies /api/* to API_URL.
GATEWAY_PORT=3001
API_URL=http://localhost:8000
# Browser -> gateway base URL, baked at web build time:
# NEXT_PUBLIC_GATEWAY_URL=http://localhost:3001
# --- Misc ---
# Optional: raises HuggingFace Hub rate limits for the embedding model download.
# HF_TOKEN=
